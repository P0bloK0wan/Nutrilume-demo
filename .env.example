PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
NODE_ENV=development
DATABASE_PATH=./data/nutrilume.sqlite
# Produção requer HTTPS, volume persistente e envio de e-mail configurado.
# Em desenvolvimento os e-mails ficam em data/mailbox.ndjson (não versionado).
RESEND_API_KEY=
MAIL_FROM=Nutrilume <contato@seu-dominio.com>
# Opcional, somente após configurar e testar o canal WhatsApp Business:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
